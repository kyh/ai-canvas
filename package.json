{
  "name": "ai-canvas",
  "version": "0.1.0",
  "private": true,
  "description": "Forkable Next.js template featuring an AI design canvas — generate, edit, and compose on an infinite canvas in natural language.",
  "keywords": [
    "ai",
    "canvas",
    "design",
    "konva",
    "nextjs",
    "react",
    "template"
  ],
  "license": "MIT",
  "author": "kyh",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyh/ai-canvas"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --report-unused-disable-directives --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm format && pnpm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@remotion/google-fonts": "^4.0.514",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.71",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eve": "^0.42.0",
    "konva": "^10.3.1",
    "lucide-react": "^1.33.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-gcolor-picker": "^1.3.5",
    "react-konva": "^19.2.5",
    "react-konva-utils": "^2.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@kyh/oxlint": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "updateConfig": {
      "ignoreDependencies": [
        "typescript"
      ]
    }
  }
}
